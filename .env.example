# Supabase project: Lastshot (ap-southeast-2)
NEXT_PUBLIC_SUPABASE_URL=https://djufzzzbrekklhtmhpmb.supabase.co
# Publishable key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SrQ3-XGbrm20SftkvzNfGw_CA28qtcC

# Secret key. Server only. Never prefix with NEXT_PUBLIC_.
# Supabase dashboard > Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=

# Public base URL used in QR codes, share links and emails, no trailing slash.
# Production defaults to https://lastshot.app when this is unset.
NEXT_PUBLIC_SITE_URL=https://lastshot.app

# Email (Resend). Domain must be verified in Resend to email guests.
RESEND_API_KEY=
# e.g. Lastshot <photos@yourdomain.com>
EMAIL_FROM=
# Optional
EMAIL_REPLY_TO=

# Optional. If set, /api/cron/gallery-emails requires "Authorization: Bearer <CRON_SECRET>"
# and the same value must be stored in Supabase Vault as lastshot_cron_secret.
CRON_SECRET=
